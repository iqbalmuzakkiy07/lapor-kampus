# Konfigurasi Supabase (Opsional: Jika tidak diisi, LaporKampus otomatis berjalan dalam mode Interactive Mock DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mode Aplikasi: 'live' atau 'demo' (default: otomatis fallback ke demo jika Supabase URL kosong)
NEXT_PUBLIC_APP_MODE=demo

